<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnative</ToolCommandName>
    <PackageId>DotNative.Cli</PackageId>
    <Version>0.1.0-beta.1</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>
  <PropertyGroup>
    <_CliSdkExcludes>../../**/bin/**;../../**/obj/**;../../**/target/**;../../**/artifacts/**;../../**/build/**;../../**/.gradle/**;../../**/.git/**;../../**/.DS_Store;../../**/.idea/**;../../**/.vs/**;../../**/.vscode/**;../../**/*.nupkg;../../**/*.snupkg;../../**/.env;../../**/.env.*;../../**/*.p12;../../**/*.pfx;../../**/*.key;../../**/*.jks;../../**/*.keystore;../../**/*.mobileprovision;../../**/.dotnative/**;../../**/dotnative.local.props;../../**/fni.public.json</_CliSdkExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../DotNative.NativeBuild/AppleDependencies.cs" Link="AppleDependencies.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None
      Include="../../src/**/*"
      Exclude="$(_CliSdkExcludes)"
      Pack="true"
      PackagePath="tools/$(TargetFramework)/any/sdk/src/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <None
      Include="../../native/**/*"
      Exclude="$(_CliSdkExcludes)"
      Pack="true"
      PackagePath="tools/$(TargetFramework)/any/sdk/native/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <None
      Include="../../eng/**/*"
      Exclude="$(_CliSdkExcludes)"
      Pack="true"
      PackagePath="tools/$(TargetFramework)/any/sdk/eng/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <None
      Include="../../templates/**/*"
      Exclude="$(_CliSdkExcludes)"
      Pack="true"
      PackagePath="tools/$(TargetFramework)/any/sdk/templates/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <None
      Include="../../plugins/**/*"
      Exclude="$(_CliSdkExcludes)"
      Pack="true"
      PackagePath="tools/$(TargetFramework)/any/sdk/plugins/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <None
      Include="../../packaging/**/*"
      Exclude="$(_CliSdkExcludes)"
      Pack="true"
      PackagePath="tools/$(TargetFramework)/any/sdk/packaging/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <None
      Include="../../tools/DotNative.DevHost/**/*"
      Exclude="$(_CliSdkExcludes)"
      Pack="true"
      PackagePath="tools/$(TargetFramework)/any/sdk/tools/DotNative.DevHost/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <None
      Include="../../tools/DotNative.NativeBuild/**/*"
      Exclude="$(_CliSdkExcludes)"
      Pack="true"
      PackagePath="tools/$(TargetFramework)/any/sdk/tools/DotNative.NativeBuild/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <None
      Include="../../tools/DotNative.Cli/**/*"
      Exclude="$(_CliSdkExcludes)"
      Pack="true"
      PackagePath="tools/$(TargetFramework)/any/sdk/tools/DotNative.Cli/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <None
      Include="../../Samples/Counter/**/*"
      Exclude="$(_CliSdkExcludes)"
      Pack="true"
      PackagePath="tools/$(TargetFramework)/any/sdk/Samples/Counter/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <None
      Include="../../Samples/WidgetSamples/**/*"
      Exclude="$(_CliSdkExcludes)"
      Pack="true"
      PackagePath="tools/$(TargetFramework)/any/sdk/Samples/WidgetSamples/%(RecursiveDir)%(Filename)%(Extension)"
    />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../THIRD_PARTY_NOTICES" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
