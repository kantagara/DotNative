<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack Condition="'$(RuntimeIdentifier)' != 'osx-arm64'"
      >true</PublishAotUsingRuntimePack>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''"
      >iossimulator-arm64</RuntimeIdentifier>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Import
    Project="../../eng/DotNative.Bindings.Sample.props"
    Condition="'$(DotNativeBindingsPlatform)' != ''"
  />
  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="bin/**;obj/**;artifacts/**;Platform/**;.dotnative/**" />
    <PackageReference
      Condition="'$(DotNativeDevelopment)' != 'true'"
      Include="DotNative.App"
      Version="0.1.0-beta.1"
    />
  </ItemGroup>
</Project>
