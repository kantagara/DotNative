<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>DotNative.Essentials</PackageId>
    <Version>0.1.0-beta.1</Version>
    <Authors>DotNative</Authors>
    <Description>Standard first-party DotNative modules. Currently bundles DeviceInfo.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../plugins/DotNative.DeviceInfo/DotNative.DeviceInfo.csproj" />
    <None Include="../../plugins/README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD_PARTY_NOTICES" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
