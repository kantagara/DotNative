<Project>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
    <DotNativeCoreArchive>$(MSBuildThisFileDirectory)../runtimes/osx-arm64/native/libcore.a</DotNativeCoreArchive>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
    <NativeFileReference Include="$(DotNativeCoreArchive)" />
    <NativeLibrary Include="$(DotNativeCoreArchive)" />
    <DirectPInvoke Include="core" />
  </ItemGroup>
</Project>
